# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans (dibutuhkan mulai M6)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Biteship (dibutuhkan mulai M5)
BITESHIP_API_KEY=
# Opsional, default: jne,jnt,sicepat,anteraja
BITESHIP_COURIERS=
# Nilai acak buatan sendiri (mis. `openssl rand -hex 32`), dipasang di dashboard Biteship
# sebagai header "x-kenbike-webhook-secret". Hanya untuk webhook (M7).
BITESHIP_WEBHOOK_SECRET=

# Opsional: alert operasional (pesanan perlu tindakan, webhook gagal) ke channel Discord.
OPS_DISCORD_WEBHOOK_URL=

# Email notifikasi (Resend, #102). Tanpa RESEND_API_KEY email dilewati (hanya log).
RESEND_API_KEY=
# Produksi: alamat di domain terverifikasi Resend, mis. "KenBike <halo@domaintoko.id>".
# Tanpa domain terverifikasi gunakan default uji Resend:
MAIL_FROM="KenBike <onboarding@resend.dev>"
# Localhost/preview: alihkan SEMUA email ke inbox ini (wajib email pemilik akun Resend
# selama domain belum diverifikasi). Kosongkan di produksi.
MAIL_DEV_TO=
# Opsional: email admin untuk pesan pembeli baru (selain alert Discord di atas).
ADMIN_NOTIFY_EMAIL=
