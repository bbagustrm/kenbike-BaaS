# Salin ke .env.local lalu isi nilainya. JANGAN commit .env.local.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SECRET — server only)
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans (dibutuhkan mulai M6)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Biteship (dibutuhkan mulai M5)
BITESHIP_API_KEY=
# Opsional, default: jne,jnt,sicepat,anteraja
BITESHIP_COURIERS=
BITESHIP_WEBHOOK_SECRET=
